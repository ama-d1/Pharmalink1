{
  "expo": {
    "name": "Pharmalink",
    "slug": "Pharmalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmalink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAuXoa1KS0x12mrwtXaeuJ6J8w6DaT4dPw"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAuXoa1KS0x12mrwtXaeuJ6J8w6DaT4dPw"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.adkusi34.Pharmalink"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A1C2E",
          "dark": {
            "image": "./assets/images/logo-icon.png",
            "backgroundColor": "#0A1C2E"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PharmaLink to use your location to find nearby pharmacies."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PharmaLink to access your photos so pharmacists can add a picture to a medication in stock.",
          "cameraPermission": "Allow PharmaLink to use your camera to record a short video clip to send in chat.",
          "microphonePermission": "Allow PharmaLink to use your microphone to record video clips with sound in chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow PharmaLink to use your microphone to record voice notes in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b4c83eb-e1d2-41e5-9f2c-380ece694170"
      }
    }
  }
}
