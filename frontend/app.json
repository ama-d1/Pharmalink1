{
  "expo": {
    "name": "Pharmalink",
    "slug": "Pharmalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmalink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAuXoa1KS0x12mrwtXaeuJ6J8w6DaT4dPw"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAuXoa1KS0x12mrwtXaeuJ6J8w6DaT4dPw"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PharmaLink to use your location to find nearby pharmacies."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PharmaLink to access your photos so pharmacists can add a picture to a medication in stock.",
          "cameraPermission": "Allow PharmaLink to use your camera to record a short video clip to send in chat.",
          "microphonePermission": "Allow PharmaLink to use your microphone to record video clips with sound in chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow PharmaLink to use your microphone to record voice notes in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}