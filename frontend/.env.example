GOOGLE_API_KEY=your_google_maps_api_key_here

# Backend API base URL. Expo only inlines env vars prefixed with EXPO_PUBLIC_.
# Leave this unset — constants/api.ts auto-detects your machine's current LAN
# IP from the Expo dev server address (Constants.expoConfig.hostUri), so the
# app finds the backend correctly on whatever network you're on, as long as
# the Spring Boot server runs on the same machine as `expo start`.
# Only set this if the backend runs somewhere else (a staging server, etc).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8080
