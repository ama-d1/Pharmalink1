# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values before running anything beyond local dev. Every value here has
# a matching default baked into docker-compose.yml / each service's
# application.yaml, so docker compose up works out of the box without a .env
# file too — this is only needed to override those defaults.

# Shared Postgres credentials (one container, one database per service).
DB_USERNAME=postgres
DB_PASSWORD=pharmalink123

# Shared HMAC secret — MUST be identical across auth-service, chat-service,
# and api-gateway (the only three that read it). Auth-service signs, the
# other two only verify. Generate a real random 32+ char value for anything
# beyond local dev; the default committed in application.yaml files is not
# a secret.
JWT_SECRET=pharmalink_super_secret_key_2026_change_me_in_prod_min_32_chars
JWT_EXPIRATION_MS=86400000

# Shared by auth-service (password-reset emails) AND notification-service
# (coming-soon roadmap item #6: order-status/appointment-reminder emails,
# added 2026-07-22) — one Gmail account, one App Password, both services
# read the same two env vars. Real Gmail address + App Password required
# (not your regular Gmail password: https://myaccount.google.com/apppasswords).
# Both password reset AND email notifications will silently fail to send
# until these are real.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Paystack (payment-service) — get test keys from your Paystack dashboard:
# Settings > API Keys & Webhooks, with "Test Mode" toggled on. GHS only —
# this project's Paystack account is Ghana-registered, and Paystack doesn't
# allow a second currency on a Ghana account. Swap for sk_live_/pk_live_ only
# once fully tested, and treat these as real secrets even in test mode.
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key

# First-admin bootstrap (auth-service) — the only supported way to create the
# very first ADMIN account without hand-editing the database. Register this
# account normally through the app FIRST (it'll come in as a PATIENT), set
# this to that exact email, then `docker compose restart auth-service`.
# Auth-service promotes it to ADMIN on startup, then this becomes a
# permanent no-op once any admin exists — safe to leave set indefinitely.
# Blank/unset = no-op, nothing happens.
FIRST_ADMIN_EMAIL=

# Google sign-in (auth-service) — comma-separated OAuth 2.0 client IDs from
# Google Cloud Console → APIs & Services → Credentials.
#
# List EVERY client the app can sign in with, normally three (Web, iOS,
# Android). The ID token's `aud` claim is whichever client actually performed
# the sign-in, and auth-service rejects any audience not in this list — that
# check is what stops a Google token minted for some other app from being
# accepted as a PharmaLink login, so it can't be skipped when this is blank.
# Blank/unset = the "Continue with Google" button fails on every attempt.
#
# The same Web + iOS + Android IDs also have to go into the app itself, in
# frontend/.env (EXPO_PUBLIC_GOOGLE_*_CLIENT_ID) — see frontend/.env.example.
GOOGLE_OAUTH_CLIENT_IDS=

# Arkesel SMS (auth-service) — sign-up verification codes are TEXTED first,
# using the phone number from the sign-up form. Get the key from your Arkesel
# dashboard → API Keys (https://sms.arkesel.com).
#
# Blank/unset is safe: the code falls back to email automatically, which is
# also what the "Send to my email instead" link on the verification screen
# uses. So SMS being down or unconfigured never blocks a sign-up.
ARKESEL_API_KEY=
# Must be a sender name you have had APPROVED in the Arkesel dashboard, max 11
# characters. An unapproved or too-long sender ID is rejected per message —
# which looks like "the SMS never arrives" rather than an obvious error.
ARKESEL_SENDER_ID=PharmaLink
# Only used to expand a locally-typed number ("024…" → "23324…"). Numbers that
# already include a country code are passed through untouched. 233 = Ghana.
SMS_DEFAULT_COUNTRY_CODE=233

# ── Production only (docker-compose.prod.yml) ─────────────────────────────
# Both are ignored by a plain `docker compose up` for local dev. See
# docs/DEPLOY.md for the full VPS walkthrough.

# Public hostname Caddy terminates TLS for. Caddy provisions a Let's Encrypt
# certificate for whatever this is set to, so it must resolve to the server
# publicly before the stack starts.
#
# No domain? Use your server's public IP with .sslip.io appended — that
# service resolves the embedded IP straight back to itself, which is enough
# for Let's Encrypt's HTTP-01 challenge:
#   SITE_ADDRESS=203.0.113.9.sslip.io
# With a domain, just use it: SITE_ADDRESS=api.yourdomain.com
SITE_ADDRESS=

# Where api-gateway publishes. Local dev leaves this unset (defaults to
# 0.0.0.0:8080, which is what makes it reachable from a phone on the LAN).
# In production set it to loopback so Caddy is the ONLY public entrypoint and
# nothing can bypass TLS by hitting :8080 directly:
#   GATEWAY_PORT_BIND=127.0.0.1:8080
GATEWAY_PORT_BIND=
